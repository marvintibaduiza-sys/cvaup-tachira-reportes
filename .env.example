# ==========================================================================
#  CVAUP Táchira — Sistema de Reportes Técnicos
#  Plantilla de configuración de entorno
#
#  AL DESPLEGAR:
#   1. Copia este archivo: cp .env.example .env
#   2. Genera APP_KEY:      php artisan key:generate
#   3. Configura los valores marcados con [OBLIGATORIO] segun tu entorno
#   4. NUNCA commitees el .env real con credenciales productivas
# ==========================================================================

APP_NAME="CVAUP Táchira"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=America/Caracas
APP_URL=https://reportes.cvaup-tachira.gob.ve

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_VE

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

# ── Logging ───────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ── Base de datos [OBLIGATORIO] ───────────────────────────────────────────
# El sistema usa MySQL/MariaDB en producción.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cvaup_tachira
DB_USERNAME=cvaup_user
DB_PASSWORD=

# ── Cuenta de administrador [OBLIGATORIO] ─────────────────────────────────
# Estas variables las lee AdminUserSeeder al correr 'php artisan db:seed'.
# Si están vacías, el seeder lanza RuntimeException (CRITICAL #1 — anti hardcode).
#
# Generar password fuerte:  openssl rand -base64 24
ADMIN_EMAIL=admin@cvaup-tachira.gob.ve
ADMIN_INITIAL_PASSWORD=

# ── Backups encriptados [OBLIGATORIO si usas spatie/laravel-backup] ───────
# Password con que se cifrará el ZIP del backup (AES-256).
# Generar:  openssl rand -base64 32
BACKUP_ARCHIVE_PASSWORD=

# ── Sesiones, cache, queue ────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

# ── Redis (opcional) ──────────────────────────────────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Email (opcional, log por default en dev) ──────────────────────────────
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@cvaup-tachira.gob.ve"
MAIL_FROM_NAME="${APP_NAME}"

# ── AWS S3 (opcional) ─────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ── Vite ──────────────────────────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"